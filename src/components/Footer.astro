---
import { AUTHOR_NAME, HOME_URL, NOTEBOOK_URL, REPO_URL, THOUGHTS_URL } from '../consts';

const year = new Date().getFullYear();
---

<footer class='site-footer'>
    <div class='site-footer__inner'>
        <p class='site-footer__copy'>
            &copy; {year}{' '}
            <a class='site-footer__me' href={HOME_URL} aria-label={`${AUTHOR_NAME}: my homepage`}>
                <span class='site-footer__wave' aria-hidden='true'>👋</span>
                <span class='site-footer__name'>{AUTHOR_NAME}</span>
                <span class='site-footer__arrow' aria-hidden='true'>↗</span>
            </a>{' '}
            · written mid-lecture, tidied before exams
        </p>
        <nav class='site-footer__links' aria-label='Footer'>
            <a href={THOUGHTS_URL}>Thoughts</a>
            <a href={NOTEBOOK_URL}>Engineering notebook</a>
            <a href={REPO_URL} target='_blank' rel='noopener noreferrer'>Source on GitHub</a>
        </nav>
    </div>
</footer>

<style>
    .site-footer {
        border-top: var(--border-width) solid var(--border);
        font-size: var(--text-sm);
    }
    .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
        max-width: calc(var(--measure-page) + 2 * var(--gutter));
        margin: 0 auto;
        padding: var(--space-8) var(--gutter);
    }
    .site-footer__copy {
        color: var(--text-subtle);
    }
    /* The way to the rest of me: ink-coloured, underlined in the red margin
       colour, and on hover the hand waves and the arrow heads off. */
    .site-footer__me {
        display: inline-flex;
        align-items: baseline;
        gap: 0.3em;
        color: var(--accent);
        font-weight: var(--weight-semibold);
        text-decoration: none;
    }
    .site-footer__me:hover {
        color: var(--accent-hover);
    }
    .site-footer__name {
        text-decoration: underline;
        text-decoration-color: var(--margin);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--duration-fast) var(--ease);
    }
    .site-footer__me:hover .site-footer__name {
        text-decoration-color: currentColor;
    }
    .site-footer__wave {
        display: inline-block;
        transform-origin: 70% 80%;
    }
    .site-footer__me:hover .site-footer__wave {
        animation: wave 900ms var(--ease);
    }
    @keyframes wave {
        20%,
        60% {
            transform: rotate(16deg);
        }
        40%,
        80% {
            transform: rotate(-8deg);
        }
    }
    .site-footer__arrow {
        font-size: 0.85em;
        transition: transform var(--duration) var(--ease);
    }
    .site-footer__me:hover .site-footer__arrow {
        transform: translate(2px, -2px);
    }
    .site-footer__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-5);
    }
    .site-footer__links a {
        color: var(--text-muted);
        text-decoration: none;
    }
    .site-footer__links a:hover {
        color: var(--accent);
    }
</style>
